<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <StartupObject>Cli</StartupObject>
    <PackageId>etunnel</PackageId>
    <Version>1.6.10</Version>
    <Authors>etunnel authors</Authors>
    <Description>Expose local services to the internet in one line of code: instant public HTTPS URLs with automatic TLS, through NAT and firewalls, no signup. Webhook-friendly ngrok-style reverse tunnel, with SDKs in 20 languages and a single-binary Go server.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ggcode/etunnel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ggcode/etunnel</RepositoryUrl>
    <PackageTags>tunnel;reverse-proxy;webhook;localhost;ngrok</PackageTags>
    <Packable>true</Packable>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>
</Project>
