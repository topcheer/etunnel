<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PackageId>etunnel</PackageId>
    <Version>1.0.0</Version>
    <Authors>etunnel authors</Authors>
    <Description>Expose a local service through an etunnel reverse-tunnel server with one line of code</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ggcode/etunnel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ggcode/etunnel</RepositoryUrl>
    <PackageTags>tunnel;reverse-proxy;webhook;localhost;ngrok</PackageTags>
    <Packable>true</Packable>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>
</Project>
