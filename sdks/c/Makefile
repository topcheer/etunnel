# generated by prumpf/etunnel build
CC ?= cc
CFLAGS ?= -O2 -Wall
PREFIX ?= /usr/local

PC_DEPS = libwebsockets libcurl json-c openssl
CFLAGS += $(shell pkg-config --cflags $(PC_DEPS) 2>/dev/null)
LIBS = $(shell pkg-config --libs $(PC_DEPS) 2>/dev/null || echo -lwebsockets -lcurl -ljson-c)

all: etunnel

etunnel: etunnel.c
	$(CC) $(CFLAGS) -o $@ $< $(LIBS)

install: etunnel
	install -D -m 755 etunnel $(DESTDIR)$(PREFIX)/bin/etunnel

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/etunnel

clean:
	rm -f etunnel

.PHONY: all install uninstall clean
