# generated by prumpf/etunnel build
CC ?= cc
CFLAGS ?= -O2 -Wall
PREFIX ?= /usr/local

PC_DEPS = libwebsockets libcurl json-c openssl
CFLAGS += $(shell pkg-config --cflags $(PC_DEPS) 2>/dev/null)
LIBS = $(shell pkg-config --libs $(PC_DEPS) 2>/dev/null || echo -lwebsockets -lcurl -ljson-c)

all: etunnel

etunnel: etunnel.c
	$(CC) $(CFLAGS) -o $@ $< $(LIBS)

install: etunnel
	install -D -m 755 etunnel $(DESTDIR)$(PREFIX)/bin/etunnel

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/etunnel

clean:
	rm -f etunnel

# Regression tests (#48): each is self-contained (fixtures + ASan builds).
# Requires Go for the test fixture server (testtools/wssserver).
# proto_gate.sh is the handshake gate (hello.version, proto_version,
# client_outdated); test_*.sh are the scenario regressions.
test:
	@for t in tests/proto_gate.sh tests/test_*.sh; do echo "== $$t =="; sh $$t || exit 1; done

.PHONY: all install uninstall clean test
